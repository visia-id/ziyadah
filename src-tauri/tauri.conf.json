{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ziyadah",
  "version": "0.0.14",
  "identifier": "id.ziyadah.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Ziyadah",
        "url": "index.html",
        "width": 900,
        "height": 720,
        "minWidth": 520,
        "minHeight": 480
      },
      {
        "label": "panel",
        "create": false,
        "title": "Ziyadah Panel",
        "url": "panel.html",
        "width": 380,
        "height": 180,
        "minWidth": 280,
        "minHeight": 100,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "resizable": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "licenseFile": "../PERNYATAAN.txt",
    "createUpdaterArtifacts": true,
    "resources": ["resources/quran.db"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFQ0Y0QkU2MjY3N0JCODQKUldTRXUzY201a3ZQem00S3dFSUp5Y29iTEVRSjhWVEIyRkt0SnY1ZkMxTTZjSW9YTEdYMmxZQkoK",
      "endpoints": ["https://github.com/visia-id/ziyadah/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
