{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ziyadah",
  "version": "0.0.1",
  "identifier": "id.ziyadah.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Ziyadah",
        "url": "index.html",
        "width": 900,
        "height": 720,
        "minWidth": 520,
        "minHeight": 480
      },
      {
        "label": "panel",
        "title": "Ziyadah Panel",
        "url": "panel.html",
        "width": 680,
        "height": 180,
        "minWidth": 280,
        "minHeight": 100,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "resizable": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
